<#
.SYNOPSIS
    TRMM script check: is the ESET Management Agent actually installed and running?
    Replaces checks that only looked for C:\Program Files\ESET / C:\ProgramData\ESET.

.DESCRIPTION
    Checks only the ESET Management Agent (the component that connects the machine to
    ESET PROTECT). It does NOT check the AV product, its alerts or definitions - the AV is
    managed from the PROTECT portal, and ermm.exe is already used for other monitoring.

    Service name 'EraAgentSvc' = ESET Management Agent (formerly "ESET Remote
    Administrator Agent"), per ESET's forum threads on restarting/upgrading the agent.

    Exit codes (TRMM treats any non-zero as failing - confirmed in TRMM source checks/models.py):
      0 = agent service installed and running
      1 = agent service missing or not running
#>

# TRMM docs: set PowerShell exit codes via $host.SetShouldExit(); exit stops the script.
function Complete-Check([int]$code) {
    $host.SetShouldExit($code)
    exit $code
}

# Look up the service by its fixed service name. A service registration can't be
# faked by leftover folders, which is what fooled the old folder-based check.
$agent = Get-Service -Name 'EraAgentSvc' -ErrorAction SilentlyContinue

if (-not $agent) {
    Write-Output "FAIL ESET Management Agent service (EraAgentSvc) is NOT installed."

    # Call out the false-positive case explicitly so the alert text explains itself.
    $leftovers = @(
        (Join-Path $env:ProgramFiles 'ESET'),
        (Join-Path $env:ProgramData  'ESET')
    ) | Where-Object { Test-Path $_ }
    if ($leftovers) {
        Write-Output "NOTE ESET folders still exist ($($leftovers -join ', ')) - likely a broken / partially removed install."
    }
    Complete-Check 1
}

if ($agent.Status -ne 'Running') {
    Write-Output "FAIL ESET Management Agent service is $($agent.Status) (StartType: $($agent.StartType))."
    Complete-Check 1
}

Write-Output "OK   ESET Management Agent service running (StartType: $($agent.StartType))."
Complete-Check 0